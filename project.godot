; Aschen – Godot-Projektdatei
; Wird von Godot selbst gelesen. Wichtig: Renderer "Compatibility" (nötig für den Web-Export).

config_version=5

[application]

config/name="Aschen"
config/description="Prototyp v0.1 – düsteres isometrisches Action-RPG mit Festungsaufbau"
run/main_scene="res://scenes/test.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[autoload]

DebugOverlay="*res://scripts/debug_overlay.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
